# Local development example. Copy to .env and replace every CHANGE_ME value.
# This file contains no usable production credential.
NODE_ENV=development
DATABASE_URL=postgresql://product_hub_dev:CHANGE_ME_DEV_PASSWORD@127.0.0.1:54329/product_hub
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/tmp/product-hub-uploads

# Local Docker PostgreSQL. Use development-only values in the copied .env.
POSTGRES_DB=product_hub
POSTGRES_USER=product_hub_dev
POSTGRES_PASSWORD=CHANGE_ME_DEV_PASSWORD
APP_PORT=3000
POSTGRES_PORT=54329

# Initial production Admin uses the separate production:bootstrap-admin command.
# Never place its password in an env file; use the hidden prompt or explicit stdin.

# Test-only credentials. Tests require an isolated database ending in _test.
TEST_ADMIN_PASSWORD=
TEST_FACTORY_A_PASSWORD=
TEST_FACTORY_B_PASSWORD=
TEST_NEW_PASSWORD=

# Operations-only variables are intentionally absent from normal development.
# Never place ADMIN_DATABASE_URL or Hard Delete Worker credentials in the Web App.

# Production template. Copy to a host-only file with restrictive permissions.
# REPLACE_AT_RUNTIME and blank values are placeholders, not working credentials.
APP_DOMAIN=product-hub.example.com
BETTER_AUTH_URL=https://product-hub.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://product-hub.example.com
BETTER_AUTH_SECRET=

POSTGRES_DB=product_hub
POSTGRES_ADMIN_USER=product_hub_db_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_USER=product_hub_migration
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_USER=product_hub_app
POSTGRES_APP_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URLs are derived safely by release:configure. Existing explicit production
# URLs remain supported when they exactly match the structured credentials.
# APP_DATABASE_URL=
# MIGRATION_DATABASE_URL=
# ADMIN_DATABASE_URL=

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/data/uploads
APP_PORT=3000
PRODUCT_HUB_COMPOSE_PROJECT=product-hub

# Select the input file with PRODUCT_HUB_ENV_FILE in the calling environment.
# Optional host layout overrides; defaults remain under /opt/product-hub.
PRODUCT_HUB_CONFIG_ROOT=/opt/product-hub/config
PRODUCT_HUB_POSTGRES_INIT_DIR=/opt/product-hub/config/postgres/init-production
PRODUCT_HUB_RELEASE_FILE=/opt/product-hub/releases/compose.release.yaml
# PRODUCT_HUB_BACKUP_ROOT=/opt/product-hub/backups

# Hard Delete operations only. This role is configurable, but must remain dedicated.
HARD_DELETE_WORKER_DB_USER=product_hub_hard_delete_worker
HARD_DELETE_WORKER_DB_PASSWORD=
# Optional until the Worker is deliberately provisioned. If set, preflight
# requires root:root 0700 parent and UID/GID 1001:1001 0400 file.
HARD_DELETE_WORKER_DATABASE_URL_SECRET_FILE=

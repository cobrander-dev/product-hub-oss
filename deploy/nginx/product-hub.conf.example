# Replace product-hub.example.com and certificate paths for your deployment.
# http context
limit_req_zone $binary_remote_addr zone=product_hub_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=product_hub_write:10m rate=30r/m;

server {
    listen 80;
    server_name product-hub.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name product-hub.example.com;

    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/private-key.pem;

    client_max_body_size 12m;
    client_body_timeout 30s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 130s;
    proxy_read_timeout 130s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /api/auth/sign-in/username {
        limit_req zone=product_hub_login burst=2 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/product-hub-proxy-headers.conf;
    }

    location ~ ^/api/(images|imports)/ {
        limit_req zone=product_hub_write burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/product-hub-proxy-headers.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/product-hub-proxy-headers.conf;
    }
}

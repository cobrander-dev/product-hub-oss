{
  "name": "product-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "prisma:generate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js validate",
    "prisma:migrate:dev": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:up": "docker compose -f compose.yaml -f compose.development.yaml up -d postgres",
    "db:down": "docker compose -f compose.yaml -f compose.development.yaml down",
    "auth:bootstrap-admin": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/production-cli.ts bootstrap-admin",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:list": "node ./node_modules/@playwright/test/cli.js test --list",
    "test:auth": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.auth.config.ts",
    "test:master-data": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.master-data.config.ts",
    "test:assignments": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.assignments.config.ts",
    "test:quotes": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.quotes.config.ts",
    "test:activity": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.activity.config.ts",
    "test:images": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.images.config.ts",
    "test:import-export": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.import-export.config.ts",
    "test:admin-ui": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.admin-ui.config.ts",
    "test:factory-ui": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.factory-ui.config.ts",
    "test:admin-operations": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.admin-operations.config.ts",
    "test:phase11": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.phase11.config.ts",
    "test:phase11:browser": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.phase11-browser.config.ts",
    "ops:configure-runtime-role": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/configure-runtime-role.ts",
    "ops:provision-hard-delete-worker-role": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/provision-hard-delete-worker-role.ts",
    "test:runtime-role": "bash tests/runtime-role-isolated.sh",
    "test:hard-delete-foundation": "bash tests/runtime-role-isolated.sh",
    "test:hard-delete-ui": "bash tests/hard-delete-ui-isolated.sh",
    "test:hard-delete-engine": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/@playwright/test/cli.js test --config=playwright.hard-delete.config.ts",
    "worker:hard-delete": "node ./node_modules/tsx/dist/cli.mjs scripts/run-hard-delete-worker.ts",
    "release:build:amd64": "sh scripts/build-production-artifacts.sh",
    "production:preflight": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/cli.ts preflight",
    "release:configure": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/cli.ts configure",
    "release:manifest:verify": "node ./node_modules/tsx/dist/cli.mjs scripts/release/verify-manifest.ts",
    "production:install": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/production-cli.ts install",
    "production:bootstrap-admin": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/production-cli.ts bootstrap-admin",
    "production:doctor": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/production-cli.ts doctor",
    "production:backup": "node ./node_modules/tsx/dist/cli.mjs scripts/installer/production-cli.ts backup",
    "test:installer-foundation": "node ./node_modules/tsx/dist/cli.mjs --test tests/installer-foundation/*.test.ts",
    "test:production-bootstrap": "node ./node_modules/tsx/dist/cli.mjs --test tests/production-bootstrap/*.test.ts",
    "test:production-install": "node ./node_modules/tsx/dist/cli.mjs tests/production-bootstrap/full-install.ts",
    "test:domain-neutral-release": "sh tests/domain-neutral-release.sh",
    "test:distribution": "node ./node_modules/tsx/dist/cli.mjs --test tests/distribution/*.test.ts",
    "test:installer-stage2": "node ./node_modules/tsx/dist/cli.mjs --test tests/installer-stage2/*.test.ts && sh tests/installer-stage2/setup-shell.sh",
    "test:deployment-workflow": "bash tests/deployment-workflow.sh",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm test:distribution && pnpm test:installer-stage2 && pnpm test:installer-foundation && pnpm test:production-bootstrap && pnpm test:deployment-workflow && pnpm test:hard-delete-engine && pnpm test:master-data && pnpm test:assignments && pnpm test:quotes && pnpm test:activity && pnpm test:images && pnpm test:import-export && pnpm test:auth && pnpm test:admin-ui && pnpm test:factory-ui && pnpm test:admin-operations && pnpm test:phase11 && pnpm test:phase11:browser && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@swc/helpers": "0.5.23",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.8",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

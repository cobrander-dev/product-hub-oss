generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FactoryStatus {
  ACTIVE
  DISABLED
}

enum DictionaryStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ENABLED
  DISABLED
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
}

enum AuditActorSource {
  USER
  SYSTEM
}

enum ActivityEventType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ENABLED
  PRODUCT_DISABLED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ENABLED
  CATEGORY_DISABLED
  MATERIAL_CREATED
  MATERIAL_UPDATED
  MATERIAL_ENABLED
  MATERIAL_DISABLED
  FACTORY_CREATED
  FACTORY_UPDATED
  FACTORY_ENABLED
  FACTORY_DISABLED
  ASSIGNMENT_ASSIGNED
  ASSIGNMENT_REVOKED
  ASSIGNMENT_REACTIVATED
  QUOTE_SUBMITTED
  QUOTE_UPDATED
  PRODUCT_MAIN_IMAGE_SET
  PRODUCT_MAIN_IMAGE_REPLACED
  PRODUCT_MAIN_IMAGE_REMOVED
  FACTORY_PRIVATE_IMAGE_SET
  FACTORY_PRIVATE_IMAGE_REPLACED
  FACTORY_PRIVATE_IMAGE_REMOVED
  PRODUCT_MAIN_IMAGE_PROMOTED
  USER_CREATED
  USER_ENABLED
  USER_DISABLED
}

enum ActivityEntityType {
  PRODUCT
  CATEGORY
  MATERIAL
  FACTORY
  ASSIGNMENT
  QUOTE
  USER
}

enum StorageProvider {
  LOCAL
}

enum ImportType {
  PRODUCT
}

enum ImportJobStatus {
  PREVIEW_READY
  CONFIRMED
}

enum ImportRowAction {
  CREATE
  UPDATE
  NO_CHANGE
  ERROR
}

enum HardDeleteTargetType {
  USER
  PRODUCT
  FACTORY
  CATEGORY
  MATERIAL
  ASSIGNMENT
  QUOTE
  PRODUCT_MAIN_IMAGE
  FACTORY_PRIVATE_IMAGE
  IMPORT_JOB
}

enum HardDeleteOperationStatus {
  PREVIEWED
  CONFIRMED
  EXECUTING
  FILES_PENDING
  COMPLETED
  FAILED
}

enum HardDeleteFileTaskStatus {
  PENDING
  PROCESSING
  RETRYABLE
  DELETED
  FAILED
}

model Factory {
  id             String                     @id @default(uuid()) @db.Uuid
  name           String
  nameNormalized String                     @unique
  contactName    String?
  phone          String?
  notes          String?
  status         FactoryStatus              @default(ACTIVE)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(3)
  users          User[]
  assignments    ProductFactoryAssignment[]

  @@index([status])
}

model Category {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  nameNormalized String           @unique
  status         DictionaryStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  products       Product[]

  @@index([status])
}

model Material {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  nameNormalized String           @unique
  status         DictionaryStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  products       Product[]

  @@index([status])
}

model Product {
  id                 String                     @id @default(uuid()) @db.Uuid
  sku                String?
  skuNormalized      String?                    @unique
  name               String
  categoryId         String                     @db.Uuid
  materialId         String                     @db.Uuid
  status             ProductStatus              @default(ENABLED)
  notes              String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  category           Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  material           Material                   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  assignments        ProductFactoryAssignment[]
  mainImage          ProductMainImage?
  importRows         ImportRow[]                @relation("TargetImportProduct")
  resolvedImportRows ImportRow[]                @relation("ResolvedImportProduct")

  @@index([categoryId])
  @@index([materialId])
  @@index([status, updatedAt(sort: Desc)])
}

model ProductFactoryAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  productId    String               @db.Uuid
  factoryId    String               @db.Uuid
  status       AssignmentStatus     @default(ACTIVE)
  assignedAt   DateTime             @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  factory      Factory              @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  quote        FactoryQuote?
  privateImage FactoryPrivateImage?

  @@unique([productId, factoryId])
  @@index([factoryId, status])
  @@index([productId, status])
}

model FactoryQuote {
  id              String                   @id @default(uuid()) @db.Uuid
  assignmentId    String                   @unique @db.Uuid
  priceCents      BigInt
  moq             Int?
  packingLengthCm Decimal?                 @db.Decimal(12, 3)
  packingWidthCm  Decimal?                 @db.Decimal(12, 3)
  packingHeightCm Decimal?                 @db.Decimal(12, 3)
  netWeightKg     Decimal?                 @db.Decimal(12, 3)
  grossWeightKg   Decimal?                 @db.Decimal(12, 3)
  pcsPerCarton    Int?
  factoryNotes    String?
  submittedAt     DateTime                 @default(now()) @db.Timestamptz(3)
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  assignment      ProductFactoryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  priceHistory    PriceHistory[]

  @@index([updatedAt(sort: Desc)])
}

model PriceHistory {
  id              String       @id @default(uuid()) @db.Uuid
  factoryQuoteId  String       @db.Uuid
  oldPriceCents   BigInt?
  newPriceCents   BigInt
  changedByUserId String?
  changedAt       DateTime     @default(now()) @db.Timestamptz(3)
  factoryQuote    FactoryQuote @relation(fields: [factoryQuoteId], references: [id], onDelete: Restrict)
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([factoryQuoteId, changedAt(sort: Desc)])
  @@index([changedByUserId, changedAt(sort: Desc)])
}

model ActivityLog {
  id                    String             @id @default(uuid()) @db.Uuid
  eventType             ActivityEventType
  entityType            ActivityEntityType
  entityId              String
  entityLabelSnapshot   String
  actorSource           AuditActorSource   @default(USER)
  actorUserId           String?
  actorRole             String
  actorUsernameSnapshot String
  factoryId             String?            @db.Uuid
  changes               Json               @db.JsonB
  metadata              Json?              @db.JsonB
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  actorUser             User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([factoryId, createdAt(sort: Desc)])
}

model StoredObject {
  id                  String               @id @default(uuid()) @db.Uuid
  storageProvider     StorageProvider      @default(LOCAL)
  storageKey          String               @unique
  mimeType            String
  sizeBytes           BigInt
  width               Int
  height              Int
  checksumSha256      String
  originalFilename    String?
  createdByUserId     String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  createdByUser       User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  productMainImage    ProductMainImage?
  factoryPrivateImage FactoryPrivateImage?
  hardDeleteFileTasks HardDeleteFileTask[]

  @@index([createdByUserId, createdAt(sort: Desc)])
  @@index([checksumSha256])
}

model ProductMainImage {
  id              String       @id @default(uuid()) @db.Uuid
  productId       String       @unique @db.Uuid
  storedObjectId  String       @unique @db.Uuid
  createdByUserId String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  storedObject    StoredObject @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  createdByUser   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
}

model FactoryPrivateImage {
  id               String                   @id @default(uuid()) @db.Uuid
  assignmentId     String                   @unique @db.Uuid
  storedObjectId   String                   @unique @db.Uuid
  uploadedByUserId String?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  assignment       ProductFactoryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  storedObject     StoredObject             @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  uploadedByUser   User?                    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([uploadedByUserId])
}

model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  type             ImportType      @default(PRODUCT)
  status           ImportJobStatus @default(PREVIEW_READY)
  originalFilename String
  checksumSha256   String
  totalRows        Int
  createRows       Int
  updateRows       Int
  noChangeRows     Int
  errorRows        Int
  createdByUserId  String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  confirmedAt      DateTime?       @db.Timestamptz(3)
  createdByUser    User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows             ImportRow[]

  @@index([createdByUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ImportRow {
  id                      String          @id @default(uuid()) @db.Uuid
  jobId                   String          @db.Uuid
  rowNumber               Int
  action                  ImportRowAction
  targetProductId         String?         @db.Uuid
  resolvedProductId       String?         @db.Uuid
  hardDeleteOperationId   String?         @db.Uuid
  normalizedData          Json?           @db.JsonB
  changes                 Json?           @db.JsonB
  errors                  Json            @db.JsonB
  targetUpdatedAtSnapshot DateTime?       @db.Timestamptz(3)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  job                     ImportJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  targetProduct           Product?        @relation("TargetImportProduct", fields: [targetProductId], references: [id], onDelete: SetNull)
  resolvedProduct         Product?        @relation("ResolvedImportProduct", fields: [resolvedProductId], references: [id], onDelete: SetNull)
  hardDeleteOperation     HardDeleteOperation? @relation(fields: [hardDeleteOperationId], references: [id], onDelete: Restrict)

  @@unique([jobId, rowNumber])
  @@index([jobId, action, rowNumber])
  @@index([targetProductId])
  @@index([resolvedProductId])
  @@index([hardDeleteOperationId])
}

model HardDeleteOperation {
  id                          String                    @id @default(uuid()) @db.Uuid
  targetType                  HardDeleteTargetType
  targetId                    String
  targetLabelSnapshot         String
  status                      HardDeleteOperationStatus @default(PREVIEWED)
  preview                     Json                      @db.JsonB
  previewSha256               String
  version                     Int                       @default(1)
  attempts                    Int                       @default(0)
  expiresAt                   DateTime                  @db.Timestamptz(3)
  leaseToken                  String?                   @db.Uuid
  leaseOwner                  String?
  leaseExpiresAt              DateTime?                 @db.Timestamptz(3)
  lastHeartbeatAt             DateTime?                 @db.Timestamptz(3)
  requestedByUserId           String?
  requestedByUsernameSnapshot String
  requestedAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  confirmedByUserId           String?
  confirmedByUsernameSnapshot String?
  confirmedAt                 DateTime?                 @db.Timestamptz(3)
  startedAt                   DateTime?                 @db.Timestamptz(3)
  databaseCommittedAt         DateTime?                 @db.Timestamptz(3)
  completedAt                 DateTime?                 @db.Timestamptz(3)
  failedAt                    DateTime?                 @db.Timestamptz(3)
  failureCode                 String?
  lastError                   String?
  verification                Json?                     @db.JsonB
  requestedByUser             User?                     @relation("HardDeleteRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  confirmedByUser             User?                     @relation("HardDeleteConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  fileTasks                   HardDeleteFileTask[]
  detachedImportRows          ImportRow[]

  @@index([targetType, targetId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@index([status, leaseExpiresAt, requestedAt])
  @@index([requestedByUserId, requestedAt(sort: Desc)])
  @@index([confirmedByUserId, confirmedAt(sort: Desc)])
}

model HardDeleteFileTask {
  id              String                   @id @default(uuid()) @db.Uuid
  operationId     String                   @db.Uuid
  storedObjectId  String?                  @db.Uuid
  storageProvider StorageProvider
  storageKey      String
  checksumSha256  String
  sizeBytes       BigInt
  status          HardDeleteFileTaskStatus @default(PENDING)
  attempts        Int                      @default(0)
  nextAttemptAt   DateTime?                @db.Timestamptz(3)
  errorCode       String?
  lastError       String?
  leaseToken      String?                  @db.Uuid
  leaseOwner      String?
  leaseExpiresAt  DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?                @db.Timestamptz(3)
  operation       HardDeleteOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict)
  storedObject    StoredObject?            @relation(fields: [storedObjectId], references: [id], onDelete: SetNull)

  @@unique([operationId, storageKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([operationId, status, leaseExpiresAt, createdAt])
  @@index([storedObjectId])
}

model User {
  id                   String                @id
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false)
  image                String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  username             String?               @unique
  role                 String                @default("FACTORY")
  banned               Boolean?              @default(false)
  banReason            String?
  banExpires           DateTime?             @db.Timestamptz(3)
  factoryId            String?               @db.Uuid
  factory              Factory?              @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  sessions             Session[]
  accounts             Account[]
  priceHistory         PriceHistory[]
  activityLogs         ActivityLog[]
  storedObjects        StoredObject[]
  productMainImages    ProductMainImage[]
  factoryPrivateImages FactoryPrivateImage[]
  importJobs           ImportJob[]
  requestedHardDeletes HardDeleteOperation[] @relation("HardDeleteRequestedBy")
  confirmedHardDeletes HardDeleteOperation[] @relation("HardDeleteConfirmedBy")

  @@index([factoryId])
  @@index([role])
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
